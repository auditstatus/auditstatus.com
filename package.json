{
  "name": "auditstatus",
  "description": "Remote attestation of what a server is running: an attester for your servers and a verifier for CI",
  "version": "2.0.1",
  "author": "Audit Status Community",
  "bin": {
    "auditstatus": "scripts/cli.js"
  },
  "bugs": {
    "url": "https://github.com/auditstatus/auditstatus.com/issues"
  },
  "c8": {
    "include": [
      "lib/**/*.js",
      "scripts/cli.js"
    ],
    "reporter": [
      "text",
      "lcov",
      "json-summary"
    ],
    "check-coverage": true,
    "branches": 100,
    "functions": 100,
    "lines": 100,
    "statements": 100
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "contributors": [
    "Audit Status Community"
  ],
  "dependencies": {
    "attestium": "^0.1.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "c8": "^10.1.3",
    "esbuild": "^0.27.3",
    "fixpack": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "marked": "^17.0.0",
    "prettier": "^3.0.0",
    "remark-cli": "^11.0.0",
    "remark-preset-github": "^4.0.4",
    "xo": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib/",
    "scripts/cli.js",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://auditstatus.com/",
  "keywords": [
    "attestation",
    "attestium",
    "audit",
    "audit-status",
    "auditstatus",
    "code-integrity",
    "continuous-verification",
    "github-actions",
    "ima",
    "process-integrity",
    "remote-attestation",
    "security",
    "supply-chain",
    "tpm",
    "transparency",
    "verification"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": [
      "xo --fix"
    ],
    "*.md": [
      "remark -qf --output --"
    ],
    "package.json": [
      "fixpack"
    ]
  },
  "main": "lib/verify.js",
  "packageManager": "pnpm@9.0.0",
  "prettier": {
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-github"
    ],
    "settings": {
      "bullet": "*",
      "fences": true,
      "listItemIndent": "one",
      "rule": "-"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auditstatus/auditstatus.com.git"
  },
  "scripts": {
    "build": "node scripts/build-sea.mjs",
    "build:binary": "bash scripts/build-binary.sh",
    "coverage": "c8 node --test test/*.test.js",
    "lint": "fixpack && remark . -qfo && xo --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "pretest": "pnpm run lint",
    "test": "node --test test/*.test.js",
    "test-coverage": "c8 node --test test/*.test.js"
  },
  "xo": {
    "rules": {
      "unicorn/prefer-module": "off",
      "import-x/extensions": "off",
      "no-unused-vars": "off",
      "no-promise-executor-return": "off",
      "n/prefer-global/process": "off",
      "unicorn/no-array-reduce": "off",
      "unicorn/prefer-top-level-await": "off",
      "unicorn/import-style": "off",
      "no-return-await": "off",
      "no-await-in-loop": "off",
      "@stylistic/function-paren-newline": "off",
      "n/prefer-global/buffer": "off",
      "unicorn/prevent-abbreviations": "off",
      "no-return-assign": "off",
      "promise/prefer-await-to-then": "off",
      "unicorn/no-process-exit": "off",
      "no-new": "off",
      "max-depth": "off",
      "unicorn/no-this-assignment": "off",
      "prefer-rest-params": "off",
      "logical-assignment-operators": "off",
      "no-dupe-class-members": "off",
      "no-dupe-keys": "off",
      "camelcase": "off",
      "no-bitwise": "off",
      "import-x/order": "off",
      "unicorn/no-await-expression-member": "off"
    },
    "space": 2
  }
}
